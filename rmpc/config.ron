#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
// ============================================
// rmpc config.ron — Catppuccin Mocha
// Place at: ~/.config/rmpc/config.ron
// ============================================
(
    address: "/home/mika/.config/mpd/socket",

    // Point to our theme file
    theme: "catppuccin-mocha",

    // Lyrics — fetches .lrc files automatically
    lyrics_dir: "/home/mika/.config/rmpc/lyrics",
    lyrics_offset_ms: 0,
    enable_lyrics_indexing: false,
    enable_lyrics_hot_reload: true,

    // Behaviour
    enable_mouse: true,
    enable_config_hot_reload: true,
    max_fps: 30,
    volume_step: 5,
    scrolloff: 3,
    wrap_navigation: false,
    select_current_song_on_change: true,
    center_current_song_on_change: true,

    // Album art via kitty protocol (ghostty supports this)
    album_art: (
        method: Kitty,
        max_size_px: (width: 1200, height: 1200),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Center,
        horizontal_align: Center,
    ),
    cava: (
    framerate: 45, // default 60
    autosens: true, // default true
    sensitivity: 100, // default 100
    lower_cutoff_freq: 50, // not passed to cava if not provided
    higher_cutoff_freq: 10000, // not passed to cava if not provided
    input: (
        method: Fifo,
        source: "/tmp/mpd.fifo",
        sample_rate: 44100,
        channels: 2,
        sample_bits: 16,
    ),
    smoothing: (
        noise_reduction: 77, // default 77
        monstercat: false, // default false
        waves: false, // default false
    ),
    // this is a list of floating point numbers thats directly passed to cava
    // they are passed in order that they are defined
    eq: []
),
    tabs: [
    (
        name: "Queue",
        pane: Split(
            direction: Horizontal,
            panes: [
                (
                    size: "30%",
                    pane: Split(
                        direction: Vertical,
                        panes: [
                            ( size: "40%", pane: Pane(AlbumArt) ),
                            ( size: "30%", pane: Pane(Lyrics) ),
                            ( size: "30%", pane: Pane(Cava) ),
                        ],
                    ),
                ),
                ( size: "70%", pane: Pane(Queue) ),
            ],
        ),
    ),
],
)
